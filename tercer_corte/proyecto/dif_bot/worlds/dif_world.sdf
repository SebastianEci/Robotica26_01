<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="empty">

    <!-- ===================== -->
    <!-- PLUGINS -->
    <!-- ===================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ===================== -->
    <!-- LUZ -->
    <!-- ===================== -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===================== -->
    <!-- PISO -->
    <!-- ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== -->
    <!-- ROBOT -->
    <!-- ===================== -->
    <!-- (NO TOCADO, ya funciona) -->
    <model name="dif_bot">
      <pose>-3.2 -3.2 0.08 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.05</ixx>
            <iyy>0.08</iyy>
            <izz>0.10</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.5 0.35 0.16</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.5 0.35 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.205 0 1.5708 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
    <material>
      <ambient>1 1 0 1</ambient>
      <diffuse>1 1 0 1</diffuse>
    </material>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.205 0 1.5708 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
    <material>
      <ambient>1 1 0 1</ambient>
      <diffuse>1 1 0 1</diffuse>
    </material>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-10000000000000000</lower>
            <upper>10000000000000000</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-10000000000000000</lower>
            <upper>10000000000000000</upper>
          </limit>
        </axis>
      </joint>


      <link name="lidar_link">
        <pose>0.15 0 0.18 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>

        <visual name="lidar_visual">
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.1 1</ambient>
            <diffuse>1.0 0.2 0.1 1</diffuse>
          </material>
        </visual>

        <sensor name="lidar_sensor" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <gz_frame_id>lidar_link</gz_frame_id>

          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </link>

      <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.41</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>

    </model>
<!-- ========================= -->
<!-- LABERINTO PRO -->
<!-- ========================= -->

<!-- PAREDES EXTERNAS -->
<model name="outer_wall_1">
  <static>true</static>
  <link name="link">
    <pose>4 0 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>0.2 8 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.2 8 2</size></box></geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="outer_wall_2">
  <static>true</static>
  <link name="link">
    <pose>-4 0 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>0.2 8 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.2 8 2</size></box></geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="outer_wall_3">
  <static>true</static>
  <link name="link">
    <pose>0 4 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>8 0.2 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>8 0.2 2</size></box></geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="outer_wall_4">
  <static>true</static>
  <link name="link">
    <pose>0 -4 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>8 0.2 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>8 0.2 2</size></box></geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<!-- PAREDES INTERNAS -->
<model name="wall_a">
  <static>true</static>
  <link name="link">
    <pose>-2 2 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>2.2 0.2 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>2.2 0.2 2</size></box></geometry>
      <material>
        <ambient>1 1 0.3 1</ambient>
        <diffuse>1 1 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_b">
  <static>true</static>
  <link name="link">
    <pose>1 -2 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>2.2 0.2 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>2.2 0.2 2</size></box></geometry>
      <material>
        <ambient>1 1 0.3 1</ambient>
        <diffuse>1 1 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>

<model name="wall_c">
  <static>true</static>
  <link name="link">
    <pose>0 1 1 0 0 0</pose>
    <collision name="collision">
      <geometry><box><size>0.2 2.2 2</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>0.2 2.2 2</size></box></geometry>
      <material>
        <ambient>1 1 0.3 1</ambient>
        <diffuse>1 1 0.3 1</diffuse>
      </material>
    </visual>
  </link>
</model>
<model name="wall_f">
  <static>true</static>
  <link name="link">
    <pose>-2 -3 1 0 0 0</pose>
    <collision name="collision"><geometry><box><size>2 0.2 2</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>2 0.2 2</size></box></geometry></visual>
    <material>
      <ambient>1 1 0 1</ambient>
      <diffuse>1 1 0 1</diffuse>
    </material>
  </link>
</model>


  </world>
</sdf>
